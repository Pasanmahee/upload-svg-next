# MongoDB (server-side)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=svgfacetpaintbynumber

# Google Cloud Storage (optional but recommended)
GCS_BUCKET_NAME=svg-image-processing-bucket
# Back-compat (older configs used this name)
GCS_BUCKET=svg-image-processing-bucket

# Credentials (choose ONE)
# Option A: path inside container / host to the service account JSON
GOOGLE_APPLICATION_CREDENTIALS=/app/keys/service-account.json
# Option B: base64-encoded service account JSON (no file needed)
GCP_SA_KEY_B64=

# Limits
MAX_RECORDS_PER_USER=3

# Set to 1 to disable GCS upload (API returns inline data URLs instead)
DISABLE_GCS=0


NEXT_PUBLIC_MONGODB_URI="mongodb+srv://pasanmahee:xc@cluster0.zwasfmo.mongodb.net/svgfacetpaintbynumber?retryWrites=true&w=majority"
GCS_BUCKET="ragappstoragebucket"
GCP_SA_KEY_B64=""
MAX_RECORDS_PER_USER=1
DISABLE_DELETE_IMAGE_API=1
FIREBASE_PROJECT_ID="number-paint-app"
FIREBASE_SERVICE_ACCOUNT_B64=""
